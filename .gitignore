# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# lockfiles (ignore if you prefer reproducible CI via registry constraints)
# package-lock.json  # Needed for HF Spaces deployment
pnpm-lock.yaml
yarn.lock
bun.lockb
npm-shrinkwrap.json

# testing
/coverage

# runtime data (SQLite databases, workspaces, deployments)
/data
/data/*
/sites
/sites/*
/public/sites
/public/sites/*
/deployments
/deployments/*
/public/deployments
/public/deployments/*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.nyc_output/

# Misc
.cache/

# Large local artifacts
project_dump.txt
*.dump
analysis.md

# Dev scripts and test infrastructure (not shipped)
/scripts/
/e2e/
/test-results/
playwright.config.ts

# Development planning docs
docs/superpowers/
